{
  "name": "one-night-junior",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview --port 4173",
    "shots": "node scripts/shots.mjs",
    "check:images": "node scripts/check-staged.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  }
}
